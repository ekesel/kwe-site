# ---- Django ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated. Add your domain(s).
ALLOWED_HOSTS=localhost,127.0.0.1,example.com
# Comma-separated, with scheme. Needed for the admin login behind TLS.
CSRF_TRUSTED_ORIGINS=https://example.com
# Public URL of the site (used by the admin "View site"/"Preview" buttons). "/" = same host.
SITE_URL=/
# Set to True once TLS is terminated in front of nginx (Caddy/Traefik/…)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ---- Database (docker compose builds DATABASE_URL from these) -----------
POSTGRES_DB=kwe
POSTGRES_USER=kwe
POSTGRES_PASSWORD=change-me

# ---- Initial admin user (created on first boot only) ----------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# ---- Ports -------------------------------------------------------------------
WEB_PORT=80

# ---- Optional: S3-compatible media storage (off by default) -----------------
USE_S3=False
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
